# gitwire
#
# ⚠️ 규칙: 패턴 뒤에 인라인 주석을 붙이지 말 것.
# gitignore 에서 '#' 는 **줄 첫 칸에서만** 주석이다.
# 따라서 "secrets/  # 설명" 은 패턴 전체를 무효화한다(실제 사고 사례).
# 설명은 항상 패턴 위에 별도 줄로 쓴다.

# 파이썬
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# 테스트·도구 캐시
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 자격증명 — 절대 커밋 금지
.env
*.token
.gitwire-token
secrets/

# gitwire 로컬 상태 (클론·커서). 개발 중 여기에 만들었을 때 대비
.gitwire-home/

# 에디터
.idea/
.vscode/
*.swp
.DS_Store
